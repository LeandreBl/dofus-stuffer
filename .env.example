# Copier ce fichier en .env, renseigner REDIS_PASSWORD et les noms du Traefik existant.
# Lancement : docker compose up --build -d
COMPOSE_PROJECT_NAME=dofus-stuffer
# Poste local sans Traefik : décommenter pour ajouter le proxy de compose.local.yaml.
# COMPOSE_FILE=compose.yaml:compose.local.yaml
PUBLIC_APP_HOST=dofus-stuffer.notdotio.com
PUBLIC_API_HOST=dofus-stuffer.api.notdotio.com
TRAEFIK_NETWORK=traefik
TRAEFIK_PROXY_HOST=traefik
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# Vide si Traefik fournit déjà les certificats ; sinon, nom de son resolver ACME.
TRAEFIK_CERT_RESOLVER=

# Panel /admin : jeton d'au moins 32 caractères (openssl rand -base64 32). Vide = admin désactivé.
ADMIN_TOKEN=

# Mot de passe Redis : choisir une valeur longue et unique. Ne pas versionner .env.
REDIS_PASSWORD=
# Nom propre au projet pour éviter les Redis d'autres applications sur le réseau Traefik.
REDIS_URL=redis://${COMPOSE_PROJECT_NAME}-redis:6379
REDIS_MAX_MEMORY=512mb
REDIS_MAX_MEMORY_POLICY=noeviction
REDIS_APPENDONLY=yes

# Images et ports internes. APP_PORT sert uniquement au mode local facultatif.
NODE_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:1.29.8-alpine
REDIS_IMAGE=redis:8-alpine
API_IMAGE=dofus-stuffer-api:local
WEB_IMAGE=dofus-stuffer-web:local
API_PORT=3000
WEB_PORT=80
APP_PORT=8080
NODE_ENV=production
CATALOG_PATH=/app/data/catalog.json
DATA_RUNTIME_DIR=/var/lib/dofus-stuffer

# Protection et ressources des conteneurs.
RESTART_POLICY=unless-stopped
CONTAINER_READ_ONLY=true
CONTAINER_CAP_DROP=ALL
CONTAINER_NO_NEW_PRIVILEGES=true
CONTAINER_TMPFS=/tmp:size=32m,mode=1777
CONTAINER_PIDS_LIMIT=256
WEB_USER=101:101
WEB_MEMORY_LIMIT=192m
WEB_CPUS=1
WEB_CACHE_TMPFS=/var/cache/nginx:size=32m,uid=101,gid=101,mode=0700
WEB_RUN_TMPFS=/var/run:size=1m,uid=101,gid=101,mode=0700
WEB_CONFIG_TMPFS=/etc/nginx/conf.d:size=1m,uid=101,gid=101,mode=0700
API_MEMORY_LIMIT=512m
API_CPUS=1
MAINTENANCE_MEMORY_LIMIT=2g
MAINTENANCE_CPUS=2
MAINTENANCE_STOP_GRACE_PERIOD=120s
REDIS_USER=999:1000
REDIS_MEMORY_LIMIT=768m
REDIS_CPUS=1

# Routage et limites du proxy existant.
HSTS_SECONDS=31536000
API_ROUTER_PRIORITY=100
API_RATE_AVERAGE=120
API_RATE_PERIOD=1m
API_RATE_BURST=60
API_INFLIGHT_LIMIT=200

# Contrôles de disponibilité.
API_HEALTH_INTERVAL=10s
API_HEALTH_TIMEOUT=5s
API_HEALTH_START_PERIOD=20s
API_HEALTH_RETRIES=5
REDIS_HEALTH_INTERVAL=5s
REDIS_HEALTH_TIMEOUT=3s
REDIS_HEALTH_RETRIES=10
MAINTENANCE_HEALTH_INTERVAL=30s
MAINTENANCE_HEALTH_TIMEOUT=10s
MAINTENANCE_HEALTH_START_PERIOD=30s
MAINTENANCE_HEALTH_RETRIES=3

# Fournisseurs HTTPS facultatifs.
MAINTENANCE_CRON="0 3 * * 1"
MAINTENANCE_TIMEZONE=Europe/Paris
CATALOG_FEED_URL=
PRICE_FEED_URL=
PATCH_FEED_URL=https://www.dofus.com/fr/rss/changelog.xml

# Uniquement pour les vérifications locales avec compose.local.yaml.
TRAEFIK_IMAGE=traefik:v3.7.14
LOCAL_PROXY_NETWORK=dofus-stuffer_local-proxy
TRAEFIK_MEMORY_LIMIT=128m
TRAEFIK_CPUS=1
TRAEFIK_HEALTH_INTERVAL=15s
TRAEFIK_HEALTH_TIMEOUT=5s
TRAEFIK_HEALTH_RETRIES=5
