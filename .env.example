# Port HTTP de Traefik, utilisé par les scripts Linux et le lanceur Windows.
APP_PORT=8080
# 127.0.0.1 pour un accès local ; 0.0.0.0 pour un accès par l’IP du serveur.
APP_BIND_ADDRESS=127.0.0.1

# Plafond de candidats évalués par recherche (1 000 à 50 000 000).
# La durée choisie dans l'interface peut arrêter la recherche avant ce plafond.
MAX_CANDIDATES=10000000

# Vérification hebdomadaire, chaque lundi à 03:00 (heure de Paris).
MAINTENANCE_CRON="0 3 * * 1"
MAINTENANCE_TIMEZONE=Europe/Paris
# Facultatif : catalogue JSON normalisé. Sinon, import public avec refus des versions plus anciennes.
CATALOG_FEED_URL=
# Flux de prix réels par serveur, indispensable pour les mises à jour automatiques des prix.
# Format documenté dans docs/MAINTENANCE.md. Aucun prix n’est inventé sans fournisseur.
PRICE_FEED_URL=
# Lecture de la dernière note officielle ; les statistiques proviennent du catalogue structuré.
PATCH_FEED_URL=https://www.dofus.com/fr/rss/changelog.xml
